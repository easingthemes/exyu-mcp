DATABASE_URL=postgres://exyu:exyu@localhost:5432/exyu

CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=

# NOTE: the `refs.embedding` column is declared `vector(1536)` in
# db/migrations/001_init.sql, which matches the default OpenAI
# `text-embedding-3-small` model. Switching EMBEDDING_PROVIDER to a model with a
# different dimension (e.g. voyage-3 = 1024, or an arbitrary local model) requires
# altering that column's dimension too — ingest and resolve both hard-fail with an
# explicit dimension-mismatch error rather than corrupting the index.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_API_KEY=
VOYAGE_API_KEY=
LOCAL_EMBEDDING_URL=

OPENSUBTITLES_API_KEY=

PORT=8787

# Public hostname Caddy terminates TLS for. Leave blank locally (falls back to
# `localhost`, no real certificate); set to the real domain in production, e.g.
# EXYU_DOMAIN=exyu-mcp.example.com
EXYU_DOMAIN=
